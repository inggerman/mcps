# =============================================================================
# mcp-notify — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in the values.
# All values are placeholders — replace with your actual credentials.
# NEVER commit the real .env file.
# =============================================================================

# --- SMTP (Email) ---
# Configure your SMTP server to send email notifications.
NOTIFY_SMTP_HOST=smtp.gmail.com
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_USER=your-email@gmail.com
NOTIFY_SMTP_PASSWORD=your-app-password
NOTIFY_SMTP_FROM=your-email@gmail.com
NOTIFY_SMTP_USE_TLS=true

# --- Telegram ---
# 1. Create a bot via @BotFather in Telegram
# 2. Copy the bot token here
# 3. Get your chat ID: send a message to the bot, then visit
#    https://api.telegram.org/bot<TOKEN>/getUpdates
NOTIFY_TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
NOTIFY_TELEGRAM_CHAT_ID=123456789

# --- Slack ---
# 1. Go to https://api.slack.com/apps and create a new app
# 2. Enable Incoming Webhooks
# 3. Create a webhook for your channel
# 4. Copy the webhook URL here
NOTIFY_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REDACTED
NOTIFY_SLACK_CHANNEL=#engineering

# --- General ---
NOTIFY_DEFAULT_TIMEOUT=30.0
LOG_LEVEL=INFO
LOG_FORMAT=json
