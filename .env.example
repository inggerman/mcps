# =============================================================================
# MCP Framework — Environment Variables
# Copia este archivo a .env y llena los valores
# =============================================================================

# --- Divisas (opcional — frankfurter.app no requiere key) ---
EXCHANGE_RATE_API_KEY=           # ExchangeRate-API.com key (opcional)
EXCHANGE_RATE_PROVIDER=frankfurter  # frankfurter | exchangerate-api

# --- OCR (mcp-documents) ---
TESSERACT_CMD=tesseract          # Path al binario tesseract (si no está en PATH)
# Windows ejemplo: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Logging ---
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                  # json (prod) | console (dev)

# --- Transport MCP ---
# 'stdio'            → uso local: Claude Desktop, Cursor, Windsurf (lanzado como subproceso)
# 'streamable-http'  → producción: servidor HTTP accesible por red (ver docker-compose.yml)
MCP_TRANSPORT=stdio

# --- Servidor HTTP (solo aplica con MCP_TRANSPORT=streamable-http) ---
MCP_HOST=0.0.0.0
# Puertos por servidor (usados en docker-compose):
#   mcp-tabular:         8001
#   mcp-calendar:        8002
#   mcp-markdown:        8003
#   mcp-prompt-engineer: 8004
#   mcp-structured-output: 8005
#   mcp-fetch:             8006
#   mcp-docker:            8007
MCP_PORT=8000

# --- mcp-fetch ---
# MCP_FETCH_DEFAULT_TIMEOUT=30       # Timeout en segundos (default: 30)
# MCP_FETCH_MAX_CONTENT_LENGTH=5242880  # Máx bytes de respuesta (default: 5MB)
# MCP_FETCH_USER_AGENT=mcp-fetch/1.0 # User-Agent HTTP
# MCP_FETCH_FOLLOW_REDIRECTS=false   # Seguir redirecciones (default: false)
# MCP_FETCH_VERIFY_SSL=true          # Verificar SSL (default: true)

# --- mcp-docker ---
# MCP_DOCKER_DOCKER_HOST=            # URL del daemon Docker (default: socket local)
# MCP_DOCKER_LOG_LINES=100           # Líneas de logs a retornar (default: 100)
# MCP_DOCKER_EXEC_TIMEOUT=30         # Timeout exec en contenedor en segundos (default: 30)

# --- mcp-kafka ---
MCP_KAFKA_BOOTSTRAP_SERVERS=localhost:9092   # Brokers Kafka (default: localhost:9092)
# MCP_KAFKA_SECURITY_PROTOCOL=PLAINTEXT      # PLAINTEXT | SSL | SASL_PLAINTEXT | SASL_SSL
# MCP_KAFKA_SASL_MECHANISM=                  # PLAIN | SCRAM-SHA-256 | SCRAM-SHA-512
# MCP_KAFKA_SASL_USERNAME=                   # Usuario SASL
# MCP_KAFKA_SASL_PASSWORD=                   # Contraseña SASL
# MCP_KAFKA_SSL_CA_LOCATION=                 # Ruta al CA certificate
# MCP_KAFKA_CONSUME_TIMEOUT=5                # Timeout consume en segundos (default: 5)
# MCP_KAFKA_MAX_CONSUME_MESSAGES=50          # Máx mensajes por consume (default: 50)

# --- mcp-structured-output ---
MCP_SO_AWS_REGION=us-east-1          # Región AWS para Bedrock (default: us-east-1)
# MCP_SO_AWS_PROFILE=                # Perfil AWS (opcional — usa credenciales default boto3 si no se define)
# MCP_SO_DEFAULT_PROVIDER=bedrock-converse  # bedrock-converse | bedrock-invoke-claude | bedrock-invoke-openweight | openai-compatible
# MCP_SO_DEFAULT_MODEL_ID=amazon.nova-pro-v1:0  # Modelo por defecto
# MCP_SO_DEFAULT_MAX_TOKENS=2048     # Max tokens por defecto
# MCP_SO_DEFAULT_TEMPERATURE=0.0     # Temperature por defecto (0.0 ideal para structured output)
# MCP_SO_OPENAI_BASE_URL=            # URL base para endpoints OpenAI-compatible
# MCP_SO_OPENAI_API_KEY=             # API key para OpenAI o compatible
# Credenciales AWS (leídas directamente por boto3 — no definir aquí en producción, usar IAM roles):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=                 # Solo si usas credenciales temporales (STS AssumeRole)

# --- Paths (opcional — rutas absolutas para montaje Docker) ---
# MCP_DATA_DIR=/data

# ---------------------------------------------------------------------------
# FASE 1 - Nuevos Servidores
# ---------------------------------------------------------------------------

# --- mcp-project-memory ---
# MEMORY_DIR=.ai-memory
# MEMORY_FILE=project_memory.json
# MEMORY_PROJECT_NAME=mcps
# MEMORY_AUTO_SYNC=false

# --- mcp-llm-router ---
