# ---------------------------------------------------------------------------
# FASE 7 - Datos y almacenamiento
# ---------------------------------------------------------------------------

# DATABASE_URL=sqlite:///./data/database.db
# DATABASE_READ_ONLY=true
# DATABASE_MAX_ROWS=500
# FILESYSTEM_ROOT=.
# FILESYSTEM_ALLOW_WRITE=false
# OBJECT_STORAGE_ENDPOINT_URL=       # URL S3-compatible; vacio usa AWS
# OBJECT_STORAGE_REGION=us-east-1
# OBJECT_STORAGE_ALLOW_WRITE=false

# ---------------------------------------------------------------------------
# FASE 8 - APIs, documentos y navegador
# ---------------------------------------------------------------------------

# OPENAPI_SPEC=./openapi.yaml
# OPENAPI_ALLOWED_ROOT=.
# OPENAPI_ALLOW_INVOKE=false
# OPENAPI_ALLOWED_HOSTS=[]           # JSON, por ejemplo ["api.example.com"]
# DOCUMENTS_ROOT=.
# DOCUMENTS_MAX_FILE_SIZE_MB=50
# BROWSER_HEADLESS=true
# BROWSER_ALLOWED_HOSTS=[]           # JSON; vacio permite cualquier host HTTP(S)
# BROWSER_OUTPUT_DIR=./data/browser

# ---------------------------------------------------------------------------
# FASE 9 - Plataforma
# ---------------------------------------------------------------------------

# KUBERNETES_CONTEXT=
# KUBERNETES_NAMESPACE=default
# KUBERNETES_IN_CLUSTER=false
# KUBERNETES_ALLOW_WRITE=false
# KUBECONFIG_DIR=./data/kube
# OBSERVABILITY_PROMETHEUS_URL=http://localhost:9090
# OBSERVABILITY_LOKI_URL=http://localhost:3100
# OBSERVABILITY_BEARER_TOKEN=
# TERRAFORM_ROOT=.
# TERRAFORM_BINARY=terraform
# TERRAFORM_ALLOW_APPLY=false

